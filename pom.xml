<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.daktoo</groupId>
    <artifactId>WormholeXDynmap</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>WormholeXDynmap</name>
    <description>Shows Wormhole X-Treme stargates on Dynmap.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <!-- Bump this to whatever API version your Paper 26.2 build reports. -->
        <paper.version>1.21.11-R0.1-SNAPSHOT</paper.version>
        <dynmap.version>3.7-beta-6</dynmap.version>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>mikeprimm</id>
            <url>https://repo.mikeprimm.com/</url>
        </repository>
        <repository>
            <id>jitpack</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>us.dynmap</groupId>
            <artifactId>DynmapCoreAPI</artifactId>
            <version>${dynmap.version}</version>
            <scope>provided</scope>
        </dependency>

        <!--
            Wormhole X-Treme, pulled straight from your GitHub repo via JitPack.

            If JitPack is being slow or you would rather build locally, clone
            https://github.com/Daktoo/Wormhole-X-Treme, run `mvn install` in it,
            then swap this block for:

                <groupId>de.luricos.bukkit</groupId>
                <artifactId>WormholeXTreme</artifactId>
                <version>1.1.6-DEV</version>
                <scope>provided</scope>
        -->
        <dependency>
            <groupId>com.github.Daktoo</groupId>
            <artifactId>Wormhole-X-Treme</artifactId>
            <version>master-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.name}-${project.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
        </plugins>
    </build>
</project>
